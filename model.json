{
  "kind": "audio_play_stream",
  "title": "Audio Play Stream",
  "ports": {
    "inputs": [{
      "id": 1, "name": "audio_in", "title": "Audio in",
      "accepts": ["audio/*"], "multiplicity": "one", "required": false,
      "execution_requirement": "not_required_for_execution", "transport": "audio_stream",
      "audio_stream": {
        "codecs": ["pcm_s16le", "opus"], "sample_rates_hz": [], "channels": [1, 2],
        "overflow_policy": "disconnect"
      }
    }, {
      "id": 2, "name": "command_in", "title": "Commande in",
      "accepts": ["application/json"], "multiplicity": "one", "required": false,
      "execution_requirement": "not_required_for_execution", "transport": "message"
    }],
    "outputs": []
  },
  "config": {"volume": 80, "muted": false, "latency_ms": 100, "max_buffer_sec": 5},
  "port_capabilities": {
    "can_add_inputs": false, "can_add_outputs": false, "allow_required_input": false,
    "default_required": false, "max_inputs": 2, "max_outputs": 0,
    "default_input_accepts": ["audio/*"], "default_output_emits": [], "default_multiplicity": "one"
  },
  "runtime": {
    "initial_state": "waiting", "runtime_executable": true, "active_worker": true,
    "generic_source": false, "centralized_executor": "generic",
    "supports_runtime_audio_streams": true, "active_execution_policy": "on_each_event"
  },
  "browser_runtime": {"audio_output": true}
}
